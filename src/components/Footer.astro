---
import { getLocaleInfo, translateFor } from "@/i18n/utils";
import Hr from "./Hr.astro";

export interface Props {
  noMarginTop?: boolean;
}

const t = translateFor(Astro.currentLocale);

const LOCALE = getLocaleInfo(Astro.currentLocale);

const prtTime = new Date();
const startTime = new Date("2025-10-26");

const dayPassed = Math.floor(
  (prtTime.getTime() - startTime.getTime()) / (1000 * 60 * 60 * 24)
);
const currentYear = prtTime.getFullYear();

const { noMarginTop = false } = Astro.props;
---

<!--Footer 部分在重构上几乎是2.0的复制黏贴。 请忽略掉报错，不影响呈现。-->
<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div class="px-4 py-6 text-sm text-slate-600 dark:text-slate-400">
    <!--Copyright 部分 -->
    <div class="mb-3 text-center sm:text-left">
      <span>Copyright &#169; 2024-{currentYear} by Asano.P.</span>
    </div>
    <!--许可协议部分 -->
    <div class="mb-3 text-center sm:text-left">
      <span class="block sm:inline">
        {t("license.CC.text.top")}
      </span>
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        class="mx-1 inline-block font-bold underline decoration-dashed underline-offset-4 hover:text-slate-800 dark:hover:text-slate-200"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t("license.CC.name")}
      </a>
      <span class="block sm:inline">
        {t("license.CC.text.down")}
      </span>
      <div class="mb-3 text-center sm:text-left">
        <span>{t("website.UpTime", { dayPassed })}</span>
      </div>
    </div>
  </div>
</footer>
